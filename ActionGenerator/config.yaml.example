# ActionGenerator Configuration File Example
# Copy this file to config.yaml and adjust the values as needed.
#
# Configuration priority (highest wins):
#   environment variables > config.yaml > built-in defaults
#
# The config file location can be overridden with ACTIONGENERATOR_CONFIG
# (default: ./config.yaml).

# Assets and their aggregate statistics are retrieved from AssetManager for the
# rule context, which is the only purpose. No data is sent.
assetmanager:
  url: http://localhost:8081  # AssetManager API URL (default: http://localhost:8081)
                              # Env: ASSETMANAGER_URL
  internal_service_key: "CHANGE-THIS-INTERNAL-SERVICE-KEY"  # Must match AssetManager's internal_service_key
                                                            # Env: ASSETMANAGER_INTERNAL_SERVICE_KEY

# SystemManager is used in both directions: the users to generate for, and per
# user the organisation record, settings and AI assignments, are retrieved; the
# liveness heartbeat is sent. It also reports the workspace mode, which decides
# whether rules are evaluated once per user or once for the whole instance.
systemmanager:
  url: http://localhost:8083  # SystemManager API URL (default: http://localhost:8083)
                              # Env: SYSTEMMANAGER_URL
  internal_service_key: "CHANGE-THIS-INTERNAL-SERVICE-KEY"  # Must match SystemManager's internal_service_key
                                                            # Env: SYSTEMMANAGER_INTERNAL_SERVICE_KEY

# Sources, tools and the source count against quota are retrieved from
# ResourceManager for the rule context, which is the only purpose. No data is sent.
resourcemanager:
  url: http://localhost:8080  # ResourceManager API URL (default: http://localhost:8080)
                              # Env: RESOURCEMANAGER_URL
  internal_service_key: "CHANGE-THIS-INTERNAL-SERVICE-KEY"  # Must match ResourceManager's internal_service_key
                                                            # Env: RESOURCEMANAGER_INTERNAL_SERVICE_KEY

# Actions are created in ActionManager, which is the only purpose. Existing
# actions are read back so a rule does not raise the same action twice, and the
# outstanding "New" actions of a rule that stopped matching are withdrawn.
actionmanager:
  url: http://localhost:8082  # ActionManager API URL (default: http://localhost:8082)
                              # Env: ACTIONMANAGER_URL
  internal_service_key: "CHANGE-THIS-INTERNAL-SERVICE-KEY"  # Must match ActionManager's internal_service_key
                                                            # Env: ACTIONMANAGER_INTERNAL_SERVICE_KEY

# AIManager holds the action rules, the JavaScript routines generated from them,
# and this module's AI assignment and system prompt — all retrieved at runtime
# and refreshed live. Generated routines are stored back here, so this is the
# one manager the daemon both reads and writes.
ai_manager:
  url: http://localhost:8085  # AIManager API URL (default: http://localhost:8085)
                              # Env: ACTIONGENERATOR_AI_MANAGER_URL
  internal_service_key: "CHANGE-THIS-INTERNAL-SERVICE-KEY"  # Must match AIManager's internal_service_key
                                                            # Env: AIMANAGER_INTERNAL_SERVICE_KEY
                                                            # Note the name: the URL is namespaced to this
                                                            # module, the key is not.

# The AI is needed only to GENERATE a routine from a rule. Evaluating an
# already-generated routine is plain JavaScript, so the daemon keeps producing
# actions with no AI configured — only code generation is refused. Which model
# is used is not configured here; it comes from AIManager.
ai:
  timeout_seconds: 300  # HTTP timeout for AI code-generation requests. Generating a
                        # routine is a long call; this is not a general API timeout.
                        # (default: 300) — Env: ACTIONGENERATOR_AI_TIMEOUT_SECONDS
  js_exec_timeout_seconds: 5  # Max seconds a single JS execution may run — loading a routine,
                              # one check(), one createAction(). Routine code is AI-generated
                              # and goja cannot be preempted, so without this a rule that never
                              # terminates hangs its goroutine for the life of the process.
                              # (default: 5) — Env: ACTIONGENERATOR_JS_EXEC_TIMEOUT_SECONDS
                              # To DISABLE the guard use the environment variable with 0: a 0
                              # here is indistinguishable from an absent key, so the default of
                              # 5 applies instead.

# Heartbeat controls the liveness signal sent to SystemManager. SystemManager
# applies its own grace period on top before declaring the service offline.
heartbeat:
  interval_seconds: 10  # Seconds between heartbeats (default: 10)
                        # Env: ACTIONGENERATOR_HEARTBEAT_INTERVAL_SECONDS

# NOTE: to_console and to_file must be stated explicitly whenever this file
# exists. Unlike every other setting, they are applied unconditionally rather
# than only when non-empty — YAML cannot distinguish an absent boolean from
# "false" — so omitting them yields false and silently disables that log sink,
# rather than falling back to the built-in default of true. Keep both keys.
log:
  file_path: /home/tachyon/log/tachyonik-actiongenerator.log  # Log file path (default: ./actiongenerator.log)
                                                              # Env: ACTIONGENERATOR_LOG_FILE
  to_console: false  # Write logs to stdout (built-in default: true; see NOTE above)
                     # Env: ACTIONGENERATOR_LOG_TO_CONSOLE (true/1 to enable)
  to_file: true      # Write logs to file_path (built-in default: true; see NOTE above)
                     # Env: ACTIONGENERATOR_LOG_TO_FILE (true/1 to enable)
  level: INFO        # Log verbosity: DEBUG, INFO, WARN, ERROR (default: INFO)
                     # Env: ACTIONGENERATOR_LOG_LEVEL
