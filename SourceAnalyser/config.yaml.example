# SourceAnalyser Configuration File Example
# Copy this file to config.yaml and adjust the values as needed.
#
# A file that cannot be read or parsed, or a key the service does not know
# (a misspelling), stops the service at startup with the reason on standard
# error. Without a file, it runs on the defaults and the environment.
#
# A number, true/false or log-level value SourceAnalyser cannot use — here or
# in a SOURCEANALYSER_* variable — stops it at startup with an error listing
# every such setting and what it takes. A 0 here counts as an absent key.
# True/false variables take true, false, 1 or 0, in any case.
#
# Configuration priority (highest wins):
#   environment variables > config.yaml > built-in defaults
#
# The config file location can be overridden with SOURCEANALYSER_CONFIG
# (default: ./config.yaml).

# Sources are read from ResourceManager (and announced over its WebSocket), and their type and status written back.
resourcemanager:
  url: http://localhost:8080  # ResourceManager API URL (default: http://localhost:8080)
                              # Env: SOURCEANALYSER_RESOURCEMANAGER_URL
  internal_service_key: "CHANGE-THIS-INTERNAL-SERVICE-KEY"  # Must match ResourceManager's internal_service_key
                                                            # Env: SOURCEANALYSER_RESOURCEMANAGER_INTERNAL_SERVICE_KEY

# Audit events and the heartbeat are sent to SystemManager. No data is retrieved.
systemmanager:
  url: http://localhost:8083  # SystemManager API URL (default: http://localhost:8083)
                              # Env: SOURCEANALYSER_SYSTEMMANAGER_URL
  internal_service_key: "CHANGE-THIS-INTERNAL-SERVICE-KEY"  # Must match SystemManager's internal_service_key
                                                            # Env: SOURCEANALYSER_SYSTEMMANAGER_INTERNAL_SERVICE_KEY
                                                            # If empty, ResourceManager's key is sent, with a
                                                            # warning; the next release requires it.

# AI configuration (model, name, system prompt) is retrieved from AIManager at runtime,
# which is the only purpose. No data is sent.
aimanager:
  url: http://localhost:8085  # AIManager API URL (default: http://localhost:8085)
                              # Env: SOURCEANALYSER_AIMANAGER_URL
  internal_service_key: "CHANGE-THIS-INTERNAL-SERVICE-KEY"  # Must match AIManager's internal_service_key
                                                            # Env: SOURCEANALYSER_AIMANAGER_INTERNAL_SERVICE_KEY
#
# Until 2026-11-20 this section was ai_manager:, and the variables were
# RESOURCEMANAGER_URL (and RESOURCEMANAGER_API_BASE_URL), RESOURCEMANAGER_INTERNAL_SERVICE_KEY,
# SYSTEMMANAGER_URL, SYSTEMMANAGER_INTERNAL_SERVICE_KEY, SOURCEANALYSER_AI_MANAGER_URL and
# AIMANAGER_INTERNAL_SERVICE_KEY. They are still read for one release, each with a warning
# naming its replacement; the next release refuses ai_manager: and ignores the old variables.

analyzer:
  sweep_interval_seconds: 300  # Seconds between sweeps of the whole source list, above 0
                               # (default: 300). Sources ResourceManager announces as waiting
                               # are analysed at once; the sweep is the safety net for a
                               # message lost while a connection was down, and also runs at
                               # startup, on reconnects and after rule changes.
                               # Env: SOURCEANALYSER_SWEEP_INTERVAL_SECONDS
                               # The former poll_interval / SOURCEANALYSER_POLL_INTERVAL is
                               # ignored with a warning; remove it (refused next release).
  js_exec_timeout_seconds: 5  # Max seconds a single AI/feed-sourced JS analysis routine
                              # may run (load or analyze) before it is interrupted, guarding
                              # against infinite loops / catastrophic regex. Above 0;
                              # only SOURCEANALYSER_JS_EXEC_TIMEOUT_SECONDS=0 disables it.
                              # (default: 5) — Env: SOURCEANALYSER_JS_EXEC_TIMEOUT_SECONDS
  max_content_bytes: 65536  # Bytes downloaded and matched for a non-PDF source (also the
                            # initial type-sniff read for any source). Above 0. (default: 65536)
                            # Env: SOURCEANALYSER_MAX_CONTENT_BYTES
  max_pdf_bytes: 33554432  # Max bytes of a PDF fetched for text extraction, bounding memory
                           # on very large PDFs. Above 0. (default: 33554432 = 32 MiB)
                           # Env: SOURCEANALYSER_MAX_PDF_BYTES

# Heartbeat controls the liveness signal sent to SystemManager. SystemManager applies
# its own grace period on top before declaring the service offline.
heartbeat:
  interval_seconds: 10  # Seconds between heartbeats, above 0 (default: 10)
                        # Env: SOURCEANALYSER_HEARTBEAT_INTERVAL_SECONDS

# NOTE: to_console and to_file must be stated explicitly whenever this file
# exists. Unlike every other setting, they are applied unconditionally rather
# than only when non-empty — YAML cannot distinguish an absent boolean from
# "false" — so omitting them yields false and silently disables that log sink,
# rather than falling back to the built-in default of true. Keep both keys.
log:
  file_path: /home/tachyon/log/tachyonik-sourceanalyser.log  # Log file path (default: ./sourceanalyser.log)
                                                             # Env: SOURCEANALYSER_LOG_FILE
  to_console: false  # Write logs to stdout/stderr (built-in default: true; see NOTE above)
                     # Env: SOURCEANALYSER_LOG_TO_CONSOLE (true, false, 1 or 0)
  to_file: true      # Write logs to file_path (built-in default: true; see NOTE above)
                     # Env: SOURCEANALYSER_LOG_TO_FILE (true, false, 1 or 0)
  level: INFO        # Log verbosity: DEBUG, INFO, WARN, ERROR, any case (default: INFO)
                     # Env: SOURCEANALYSER_LOG_LEVEL
